# Frontend is deployed to S3 behind CloudFront (not configured in this file).
# This file only sets the build-time API base URL (Lambda + API Gateway).

# ── API ───────────────────────────────────────────────────────────────────────
# Set to your API Gateway invoke URL + /api (from `serverless deploy` output):
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.ap-southeast-2.amazonaws.com/api

# ── Feature flags ─────────────────────────────────────────────────────────────
VITE_PUBLIC_SITE_ENABLED=true
VITE_ENV=production
