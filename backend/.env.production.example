NODE_ENV=production

# AWS layout (manual or scripted):
#   S3 + CloudFront     → static frontend (separate from this file; see web/.env.production)
#   S3 (uploads)        → S3_BUCKET below (images; presigned PUT from API)
#   S3 (deploy zip)     → auto-created by Serverless on first deploy (not configured here)
#   Lambda + API GW   → this service (SERVER_PUBLIC_URL)
#   Aurora DSQL       → AURORA_DSQL_* below (IAM from Lambda role)

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
# Set to your API Gateway invoke URL (shown after `serverless deploy`):
SERVER_PUBLIC_URL=https://xxxxxxxxxx.execute-api.ap-southeast-2.amazonaws.com
OPENAPI_SERVER_URL=https://xxxxxxxxxx.execute-api.ap-southeast-2.amazonaws.com

# ── CORS ──────────────────────────────────────────────────────────────────────
# Your CloudFront domain OR custom domain:
CORS_ORIGIN=https://dxxxxxxxxxxxxxxxxx.cloudfront.net

# ── Database — Aurora DSQL with IAM ──────────────────────────────────────────
# No static password needed. Lambda signs a short-lived token at cold start.
# The IAM role in serverless.yml already has dsql:DbConnectAdmin on cluster/*.
AURORA_DSQL_IAM_AUTH=true
AURORA_DSQL_HOST=your-cluster.dsql.ap-southeast-2.on.aws
AURORA_DSQL_REGION=ap-southeast-2
# Token lifetime in seconds (default 900 = 15 min). Refresh runs every 10 min.
AURORA_DSQL_TOKEN_EXPIRES_SEC=900

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-at-least-48-characters
JWT_EXPIRES_IN=7d

# Super Admin credentials — always from env vars, NEVER changeable from UI.
# Update these + redeploy to change the super admin mobile or PIN.
SUPER_ADMIN_MOBILE=02xxxxxxxxx
SUPER_ADMIN_OTP=change-me-to-a-6-digit-pin

# ── S3 File Uploads ───────────────────────────────────────────────────────────
S3_BUCKET=propertyreach-uploads-prod
S3_REGION=ap-southeast-2
# S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY are NOT needed in Lambda.
# The Lambda execution role handles S3 auth automatically.
# Only set these for local development if you want to test S3 uploads locally.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# CloudFront domain in front of the uploads bucket — all image URLs stored in DB use this:
S3_PUBLIC_URL_PREFIX=https://dxxxxxxxxxxxxxxxxx.cloudfront.net

# ── Feature flags ─────────────────────────────────────────────────────────────
PUBLIC_LISTINGS_API_ENABLED=true
API_DOCS_ENABLED=false
EXPOSE_ADMIN_API_INFO=false
LOG_HTTP=false
APP_SETUP_SECRET=replace-with-a-long-random-setup-secret-at-least-48-characters

# ── Deploy script helpers ─────────────────────────────────────────────────────
# Used by scripts/deploy-frontend.sh:
S3_FRONTEND_BUCKET=propertyreach-frontend-prod
CF_DISTRIBUTION_ID=EXXXXXXXXXXXXX
AWS_REGION=ap-southeast-2
