NODE_ENV=development

# Server
PORT=3001
SERVER_PUBLIC_URL=http://localhost:3001
OPENAPI_SERVER_URL=http://localhost:3001

# CORS (frontend dev origin)
CORS_ORIGIN=http://localhost:5173

# Database (update username/password if your local Postgres differs)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/propertyreach?schema=public

# Auth (must be strong in production)
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=7d

# Local development toggles
PUBLIC_LISTINGS_API_ENABLED=true
API_DOCS_ENABLED=true
EXPOSE_ADMIN_API_INFO=true
OTP_DEV_ALLOW_NO_TWILIO=true
LOG_HTTP=true

# First-time bootstrap for creating initial super admin
APP_SETUP_SECRET=replace-with-a-long-random-setup-secret-at-least-32-characters

# Local OTP test bypass (optional)
ADMIN_TEST_MOBILE=0210000000
ADMIN_TEST_OTP=123456

# Twilio (optional in local dev)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── S3 Image Upload ────────────────────────────────────────────────────────────
# Required to enable drag-and-drop photo upload for profiles and listings.
# Leave commented out to disable S3 upload (frontend falls back to URL input).
#
# Bucket CORS must allow PUT from your frontend origin:
#   AllowedOrigins: ["http://localhost:5173"]   (add prod URL too)
#   AllowedMethods: ["PUT"]
#   AllowedHeaders: ["Content-Type", "Content-Length"]
#
# S3_BUCKET=your-bucket-name
# S3_REGION=ap-southeast-2
# S3_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
# S3_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# S3_PUBLIC_URL_PREFIX=https://your-bucket-name.s3.ap-southeast-2.amazonaws.com
# (or use a CloudFront URL: https://dxxxxxxxxxxxx.cloudfront.net)
